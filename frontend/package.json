{
  "name": "game-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "1.21.0",
    "framer-motion": "12.23.25",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-pdf": "10.2.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "scripts": {
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.cjs",
    "predev": "npm run prepare:pdf-worker",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "node .next/standalone/server.js",
    "prebuild": "npm run prepare:pdf-worker",
    "build": "next build",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "node scripts/run-checks.cjs",
    "lint:code": "node scripts/run-eslint.cjs",
    "lint:architecture": "node scripts/check-architecture.cjs",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0 && node scripts/check-styles.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "postbuild": "node scripts/prepare-standalone.cjs"
  },
  "devDependencies": {
    "@babel/parser": "7.28.4",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.12",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-import": "2.32.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "sass": "1.93.2",
    "stylelint": "17.16.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5",
    "brace-expansion@^1.0.0": "1.1.21",
    "glob": "14.0.4"
  }
}
