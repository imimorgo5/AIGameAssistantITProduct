{
  "name": "game-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "1.12.2",
    "framer-motion": "12.23.25",
    "pdfjs-dist": "5.4.296",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-pdf": "10.2.0",
    "react-router-dom": "6.30.1"
  },
  "scripts": {
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.cjs",
    "prestart": "npm run prepare:pdf-worker",
    "start": "react-scripts start",
    "prebuild": "npm run prepare:pdf-worker",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "eject": "react-scripts eject",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/run-checks.cjs lint",
    "lint:code": "node scripts/run-eslint.cjs",
    "lint:architecture": "node scripts/check-architecture.cjs",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0 && node scripts/check-styles.cjs",
    "format": "node scripts/run-checks.cjs format",
    "format:code": "node scripts/run-eslint.cjs --fix",
    "format:styles": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0 --fix",
    "format:check": "npm run lint"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "<rootDir>/node_modules/axios/dist/browser/axios.cjs"
    }
  },
  "devDependencies": {
    "@babel/parser": "7.28.4",
    "@eslint/eslintrc": "2.1.4",
    "@stylistic/eslint-plugin": "3.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "27.5.2",
    "@types/node": "22.18.12",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "8.57.1",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.32.0",
    "http-proxy-middleware": "2.0.9",
    "postcss-scss": "4.0.9",
    "react-scripts": "5.0.1",
    "sass": "1.93.2",
    "stylelint": "17.16.0",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  }
}
