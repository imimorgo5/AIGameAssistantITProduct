# Copy to .env. Never commit the filled .env file.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=80
APP_PUBLIC_URL=http://localhost

POSTGRES_DB=game_assistant_db
POSTGRES_USER=app_user
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate each JWT secret separately: openssl rand -base64 64
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=

# Initial administrator (created once; set email, login and password).
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Local inbox: http://localhost:8025. For real SMTP enable auth and STARTTLS.
EMAIL_ADDRESS=noreply@example.com
EMAIL_APP_PASSWORD=
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
MAILPIT_PORT=8025

# OpenRouter key stays on the backend. The model catalog is backend/config/ai-models.yaml.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

# Optional SOCKS5 proxy for OpenRouter; leave the host empty for a direct connection.
PROXY_HOST=
PROXY_PORT=1080
PROXY_LOGIN=
PROXY_PASSWORD=

# Local backend only: export these before ./gradlew bootRun.
# Docker derives these values from POSTGRES_* and overrides them in compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/game_assistant_db
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=

# Frontend development uses frontend/.env (see frontend/.env.example).
# DEV_API_TARGET, PORT, HOST, BROWSER, HTTPS and PUBLIC_URL are documented there.
GUEST_DAILY_BUDGET=200
GUEST_CLIENT_IP_HEADER=
